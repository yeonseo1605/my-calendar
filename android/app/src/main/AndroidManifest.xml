<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="My Calendar"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyCalendar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mycalendar" android:host="widget-settings" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WidgetSettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.MyCalendarWidgetProvider"
            android:label="@string/widget_month_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.yeonseo.mycalendar.widget.PREVIOUS_MONTH" />
                <action android:name="com.yeonseo.mycalendar.widget.NEXT_MONTH" />
                <action android:name="com.yeonseo.mycalendar.widget.PREVIOUS_WEEK" />
                <action android:name="com.yeonseo.mycalendar.widget.NEXT_WEEK" />
                <action android:name="com.yeonseo.mycalendar.widget.TODAY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/my_calendar_widget_info" />
        </receiver>

        <receiver android:name=".widget.TodayWidgetProvider" android:label="@string/widget_today_name" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver android:name=".widget.WeekWidgetProvider" android:label="@string/widget_week_name" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.yeonseo.mycalendar.widget.PREVIOUS_WEEK" />
                <action android:name="com.yeonseo.mycalendar.widget.NEXT_WEEK" />
                <action android:name="com.yeonseo.mycalendar.widget.TODAY" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_week_info" />
        </receiver>

        <receiver android:name=".widget.AgendaWidgetProvider" android:label="@string/widget_agenda_name" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_agenda_info" />
        </receiver>

        <receiver android:name=".widget.MonthAgendaWidgetProvider" android:label="@string/widget_month_agenda_name" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.yeonseo.mycalendar.widget.PREVIOUS_MONTH" />
                <action android:name="com.yeonseo.mycalendar.widget.NEXT_MONTH" />
                <action android:name="com.yeonseo.mycalendar.widget.TODAY" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_month_agenda_info" />
        </receiver>
    </application>
</manifest>
