<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="1dp" android:background="@drawable/widget_day_today">
    <TextView android:id="@+id/widgetDayNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/widgetEventTitle" android:layout_width="match_parent" android:layout_height="13dp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="7sp" android:textStyle="bold" android:includeFontPadding="false" />
    <TextView android:id="@+id/widgetEventMore" android:layout_width="match_parent" android:layout_height="9dp" android:gravity="center" android:maxLines="1" android:textColor="#E6DEFF" android:textSize="7sp" android:includeFontPadding="false" />
</LinearLayout>
