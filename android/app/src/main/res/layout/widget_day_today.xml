<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="1dp" android:background="@drawable/widget_day_today">
    <TextView android:id="@+id/widgetDayNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/widgetEventWrap" android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widgetEventAccent" android:layout_width="5dp" android:layout_height="match_parent" android:gravity="center" android:text="┃" android:textColor="#7D73E6" android:textSize="12sp" android:includeFontPadding="false" />
        <TextView android:id="@+id/widgetEventTitle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:id="@+id/widgetEventMore" android:layout_width="match_parent" android:layout_height="12dp" android:gravity="center" android:maxLines="1" android:textColor="#E6DEFF" android:textSize="9sp" android:includeFontPadding="false" />
</LinearLayout>
