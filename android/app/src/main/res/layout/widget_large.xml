<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widgetPrevious" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="24sp" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widgetMonthTitle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widgetToday" android:layout_width="44dp" android:layout_height="34dp" android:gravity="center" android:text="오늘" android:textColor="#E6DEFF" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widgetNext" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="›" android:textColor="#FFFFFF" android:textSize="24sp" android:layout_marginStart="5dp" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widgetSettings" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="⚙" android:textColor="#DCE1F0" android:textSize="18sp" android:layout_marginStart="5dp" android:background="@drawable/widget_button" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:layout_marginTop="5dp">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="일" android:textColor="#E06473" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="월" android:textColor="#BDC2D1" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="화" android:textColor="#BDC2D1" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="수" android:textColor="#BDC2D1" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="목" android:textColor="#BDC2D1" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="금" android:textColor="#BDC2D1" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="토" android:textColor="#789AE0" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetCalendarRows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#40535A69" android:layout_marginTop="5dp" android:layout_marginBottom="4dp" />
    <LinearLayout android:id="@+id/widgetAgenda" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.48" android:orientation="vertical" />
</LinearLayout>
